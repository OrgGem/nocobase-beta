{
  "name": "plugin-microsoft-graph-gateway",
  "displayName": "Microsoft Graph Gateway",
  "displayName.zh-CN": "Microsoft Graph 网关",
  "displayName.vi-VN": "Gateway Microsoft Graph",
  "description": "Queue-backed Microsoft Graph gateway for Outlook, Lists, OneDrive and SharePoint.",
  "version": "1.1.2",
  "license": "Apache-2.0",
  "main": "dist/server/index.js",
  "scripts": {
    "build:plugin": "yarn --cwd ../../.. nocobase build plugin-microsoft-graph-gateway --no-dts",
    "copy:runtime-deps": "node scripts/copy-runtime-deps.cjs",
    "prepack": "npm run build:plugin && npm run copy:runtime-deps"
  },
  "keywords": [
    "Data sources",
    "Microsoft Graph",
    "Outlook",
    "OneDrive",
    "SharePoint"
  ],
  "files": [
    "dist",
    "client.js",
    "client.d.ts",
    "client-v2.js",
    "client-v2.d.ts",
    "server.js",
    "server.d.ts",
    "README.md"
  ],
  "nocobase": {
    "supportedVersions": [
      "2.x"
    ],
    "editionLevel": 0
  },
  "dependencies": {
    "@azure/abort-controller": "^2.1.2",
    "@azure/core-auth": "^1.10.1",
    "@azure/core-client": "^1.10.1",
    "@azure/core-rest-pipeline": "^1.23.0",
    "@azure/core-tracing": "^1.3.1",
    "@azure/core-util": "^1.13.1",
    "@azure/identity": "^4.4.1",
    "@azure/logger": "^1.3.0",
    "@azure/msal-browser": "^5.10.1",
    "@azure/msal-common": "^16.6.1",
    "@azure/msal-node": "^5.2.1",
    "@babel/runtime": "^7.26.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "jsonwebtoken": "^9.0.2",
    "open": "^8.4.2",
    "tslib": "^2.6.2",
    "uuid": "^10.0.0"
  },
  "peerDependencies": {
    "@nocobase/actions": "2.x",
    "@nocobase/client-v2": "2.x",
    "@nocobase/database": "2.x",
    "@nocobase/flow-engine": "2.x",
    "@nocobase/server": "2.x"
  }
}
