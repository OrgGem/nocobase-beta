{
  "name": "plugin-skill-creator",
  "displayName": "Skill Creator Skill",
  "displayName.vi-VN": "Skill tạo Skill",
  "description": "Create and install new Skill Hub skills from AI Employee generated specifications.",
  "description.vi-VN": "Tạo và cài skill mới vào Skill Hub từ đặc tả do AI Employee sinh ra.",
  "version": "1.0.5",
  "license": "Apache-2.0",
  "keywords": [
    "AI",
    "Skill",
    "Skill Hub"
  ],
  "files": [
    "dist",
    "client.js",
    "server.js",
    "client.d.ts",
    "server.d.ts",
    "client-v2.js",
    "client-v2.d.ts",
    "src"
  ],
  "scripts": {
    "prepack": "powershell -Command \"Copy-Item -Path src/server/skills/* -Destination dist/server/skills/ -Recurse -Force\""
  },
  "main": "dist/server/index.js",
  "peerDependencies": {
    "@nocobase/client": "2.x",
    "@nocobase/server": "2.x",
    "plugin-agent-orchestrator": ">=1.0.0",
    "@nocobase/client-v2": "2.x",
    "@nocobase/flow-engine": "2.x"
  },
  "nocobase": {
    "supportedVersions": [
      "2.x"
    ],
    "editionLevel": 0
  }
}
