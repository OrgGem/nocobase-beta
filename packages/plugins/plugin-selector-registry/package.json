    "src",
    "client.js",
    "server.js",
    "client.d.ts",
    "server.d.ts",
    "client-v2.js",
    "client-v2.d.ts"
  ],
  "nocobase": {
    "supportedVersions": [
      "2.x"
    ],
    "editionLevel": 0
  },
  "dependencies": {
    "css-select": "^4.3.0",
    "dom-serializer": "^2.0.0",
    "domutils": "^2.8.0",
    "htmlparser2": "^8.0.2"
  },
  "peerDependencies": {
    "@nocobase/client": "2.x",
    "@nocobase/client-v2": "2.x",
    "@nocobase/server": "2.x",
    "@nocobase/database": "2.x",
    "@nocobase/test": "2.x",
    "@nocobase/flow-engine": "2.x",
    "@nocobase/plugin-ai": "2.x"
  },
  "peerDependenciesMeta": {
