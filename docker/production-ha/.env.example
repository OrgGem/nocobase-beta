# ==============================================================================
# NocoBase Production HA - Environment Variables
# Copy this file to .env and update the values
# ==============================================================================

# NocoBase version
NOCOBASE_VERSION=2.0.32-full

# Security keys (REQUIRED - generate with: openssl rand -hex 32)
APP_KEY=change-me-to-a-random-string
ENCRYPTION_FIELD_KEY=change-me-to-another-random-string

# Port (ALB handles HTTPS/HTTP2, this stack serves HTTP only)
HTTP_PORT=80

# Timezone
TZ=UTC

# Database
DB_DATABASE=nocobase
DB_USER=nocobase
DB_PASSWORD=change-me-strong-password

# Redis URLs — use separate databases to avoid key conflicts
# Without password:
CACHE_REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1
PUBSUB_ADAPTER_REDIS_URL=redis://redis:6379/2
QUEUE_ADAPTER_REDIS_URL=redis://redis:6379/3
LOCK_ADAPTER_REDIS_URL=redis://redis:6379/4
# With password:
# CACHE_REDIS_URL=redis://:your-redis-password@redis:6379/0
# REDIS_URL=redis://:your-redis-password@redis:6379/1
# PUBSUB_ADAPTER_REDIS_URL=redis://:your-redis-password@redis:6379/2
# QUEUE_ADAPTER_REDIS_URL=redis://:your-redis-password@redis:6379/3
# LOCK_ADAPTER_REDIS_URL=redis://:your-redis-password@redis:6379/4

# Custom plugins to append (comma-separated plugin names)
# Example: plugin-worker-monitor,plugin-custom-llm
APPEND_PRESET_LOCAL_PLUGINS=plugin-worker-monitor

# Package cache mirrors used by plugin-cluster-manager package installer
NPM_REGISTRY_URL=http://nginx-cache-registry/npm/
APT_MIRROR_URL=http://nginx-cache-registry/debian/
PYPI_INDEX_URL=http://nginx-cache-registry/pypi-simple/

# plugin-git-manager
# Binary used by git-manager actions. Keep "git" unless you install it elsewhere.
GIT_BINARY_PATH=git

# ==============================================================================
# plugin-ai-browser — Playwright Browser Automation (optional)
# Requires the browserless service to be running
# ==============================================================================

# URL of the headless browser controlled by Playwright CDP
AI_BROWSER_CDP_URL=ws://browser:3000

# Public/same-origin URL used by the AI Browser iframe.
# Keep this as a relative URL when using the bundled nginx proxy.
AI_BROWSER_LIVE_URL=/ai-browser-live/

# Internal Browserless sessions endpoint used to resolve a session-specific live URL
AI_BROWSER_SESSIONS_URL=http://browser:3000/sessions

# Keep AI browser sessions available for live review after actions finish
AI_BROWSER_SESSION_TTL_SECONDS=1800

# Port for the Live Web Debug Viewer
BROWSERLESS_PORT=3000

# ==============================================================================
# Lightweight External RAG / Embedding service
# ==============================================================================

# Internal URL used in NocoBase EXTERNAL_RAG knowledge bases:
# ragProvider=external-http
# ragApiUrl=http://rag-service:8000/search
RAG_SERVICE_URL=http://rag-service:8000

# Optional host port bindings for local admin/debug access.
# Keep bound to 127.0.0.1 in production unless you add your own auth/proxy layer.
RAG_SERVICE_PORT=127.0.0.1:8008
QDRANT_PORT=127.0.0.1:6333

# Optional Bearer token for /ingest, /delete, /search.
# If set, configure the same value as ragApiKey in the NocoBase EXTERNAL_RAG KB.
RAG_API_KEY=

# Embedding provider used by rag-service:
# - openai-compatible: call OPENAI_EMBEDDING_BASE_URL /embeddings
# - fastembed: run a local ONNX model inside rag-service
RAG_EMBEDDING_PROVIDER=openai-compatible

# Optional fallback: your existing E5 OpenAI-compatible endpoint, without /embeddings.
# When the NocoBase KB uses ragProvider=e5-http, this is supplied from llmServices instead.
# Example: http://your-e5-api:8080/v1
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=

# Good default for English/Vietnamese retrieval.
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
RAG_DEFAULT_NAMESPACE=nocobase
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_EMBED_QUERY_PREFIX=query: 
RAG_EMBED_PASSAGE_PREFIX=passage: 
