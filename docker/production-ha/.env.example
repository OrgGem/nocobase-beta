# ==============================================================================
# NocoBase Production HA - Environment Variables
# Copy this file to .env and update the values
# ==============================================================================

# NocoBase version
NOCOBASE_VERSION=2.0.32-full

# Security keys (REQUIRED - generate with: openssl rand -hex 32)
APP_KEY=change-me-to-a-random-string
ENCRYPTION_FIELD_KEY=change-me-to-another-random-string

# Port (ALB handles HTTPS/HTTP2, this stack serves HTTP only)
HTTP_PORT=80

# Timezone
TZ=UTC

# Database
DB_DATABASE=nocobase
DB_USER=nocobase
DB_PASSWORD=change-me-strong-password

# Redis URLs — use separate databases to avoid key conflicts
# Without password:
CACHE_REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1
PUBSUB_ADAPTER_REDIS_URL=redis://redis:6379/2
QUEUE_ADAPTER_REDIS_URL=redis://redis:6379/3
LOCK_ADAPTER_REDIS_URL=redis://redis:6379/4
# With password:
# CACHE_REDIS_URL=redis://:your-redis-password@redis:6379/0
# REDIS_URL=redis://:your-redis-password@redis:6379/1
# PUBSUB_ADAPTER_REDIS_URL=redis://:your-redis-password@redis:6379/2
# QUEUE_ADAPTER_REDIS_URL=redis://:your-redis-password@redis:6379/3
# LOCK_ADAPTER_REDIS_URL=redis://:your-redis-password@redis:6379/4

# Custom plugins to append (comma-separated plugin names)
# Example: plugin-worker-monitor,plugin-custom-llm
APPEND_PRESET_LOCAL_PLUGINS=plugin-worker-monitor
