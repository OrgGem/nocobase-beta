# Copy to .env.app-ha on BOTH application servers. Except for NODE_* identity,
# the values must be identical on the two servers.

COMPOSE_PROJECT_NAME=nocobase-ha
NOCOBASE_VERSION=2.1.9-full
APP_HOST_PORT=13000
APP_NAME=main
TZ=Asia/Ho_Chi_Minh

# Generate independent strong values, then copy the exact same values to both nodes.
APP_KEY=change-me-with-openssl-rand-hex-32
APP_AES_SECRET_KEY=change-me-with-another-openssl-rand-hex-32
ENCRYPTION_FIELD_KEY=change-me-with-another-openssl-rand-hex-32

# External shared PostgreSQL endpoint. Only one management node should run upgrades.
DB_HOST=postgres.internal
DB_PORT=5432
DB_DATABASE=nocobase
DB_USER=nocobase
DB_PASSWORD=change-me
DB_SSL=false
DB_LOGGING=off

# Option A: separate Redis services by failure/eviction policy (recommended).
# Cache Redis may use LRU/LFU. Queue and coordination Redis must use noeviction.
CACHE_REDIS_URL=redis://cache-redis.internal:6379/0
PUBSUB_ADAPTER_REDIS_URL=redis://coordination-redis.internal:6379/0
LOCK_ADAPTER_REDIS_URL=redis://coordination-redis.internal:6379/1
QUEUE_ADAPTER_REDIS_URL=redis://queue-redis.internal:6379/0
WORKER_ID_REDIS_URL=redis://coordination-redis.internal:6379/2
REDIS_URL=redis://coordination-redis.internal:6379/2

# Option B: one non-clustered Redis server with separate logical databases.
# CACHE_REDIS_URL=redis://redis.internal:6379/0
# PUBSUB_ADAPTER_REDIS_URL=redis://redis.internal:6379/1
# LOCK_ADAPTER_REDIS_URL=redis://redis.internal:6379/2
# QUEUE_ADAPTER_REDIS_URL=redis://redis.internal:6379/3
# WORKER_ID_REDIS_URL=redis://redis.internal:6379/4
# REDIS_URL=redis://redis.internal:6379/4

# NFSv4 export containing the shared custom plugin directory.
NFS_SERVER=10.0.10.20
NFS_PLUGIN_EXPORT=/exports/nocobase/plugins
NFS_VERSION=4
NFS_PLUGIN_VOLUME_NAME=nocobase-ha-shared-plugins

# The cluster manager must already be available in the image or shared plugin directory.
APPEND_PRESET_LOCAL_PLUGINS=plugin-cluster-manager
LOGGER_LEVEL=info
LOGGER_TRANSPORT=console,dailyRotateFile
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5

# Optional per-host identity. The compose profile already selects the actual node.
NODE_1_HOSTNAME=nocobase-app-1
NODE_2_HOSTNAME=nocobase-app-2
